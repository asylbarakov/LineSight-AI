# --- Администратор (задача 30) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=12

# --- База данных ---
POSTGRES_USER=linesight
POSTGRES_PASSWORD=linesight
POSTGRES_DB=linesight
DATABASE_URL=postgresql+psycopg://linesight:linesight@postgres:5432/linesight

# --- Очередь ---
REDIS_URL=redis://redis:6379/0

# --- Хранилище ---
DATA_DIR=/data
MAX_UPLOAD_MB=500

# --- Пайплайн ---
FRAME_STEP_SEC=0.5
DETECT_CONF=0.25
MODEL_PATH=/data/weights/best.pt
TASK_SOFT_TIME_LIMIT_SEC=900

# --- Порог «недостаточная видимость» ---
SHARPNESS_MIN=60.0
BRIGHTNESS_MIN=50.0
LOW_VIS_MIN_SEC=2.0

# --- Фронтенд ---
NEXT_PUBLIC_USE_MOCKS=false
API_INTERNAL_URL=http://api:8000
