# Первый запуск: sh ./start.sh или .\start.ps1 — .env и секреты создаются автоматически.
# Ручная настройка: замените все change-me перед запуском; старый том хранит старый пароль.
# --- Администратор ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=12

# --- База данных ---
POSTGRES_USER=linesight
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=linesight
# Compose passes these same fields to PostgreSQL, API and Worker.
# Changing them does NOT change a password/user/database already stored in a volume.
# Quote literal passwords containing $ or # with single quotes in .env.
# DATABASE_URL is optional only for non-Compose/external database deployments.

# --- Очередь: задачи лежат в Postgres, воркер опрашивает таблицу ---
POLL_INTERVAL_SEC=1.0

# --- Хранилище ---
DATA_DIR=/data
MAX_UPLOAD_MB=500

# --- Пайплайн ---
FRAME_STEP_SEC=0.5
DETECT_CONF=0.25
MODEL_PATH=/data/weights/best.pt
# none | synthetic | yolo | auto. Приёмочная сборка: none (только «недостаточная видимость»).
# yolo экспериментальный (на реальных снимках recall 33%), synthetic работает только на синтетических роликах,
# auto = yolo, если есть веса.
DETECTOR=none
INSTALL_YOLO=0
TASK_SOFT_TIME_LIMIT_SEC=900

# --- Порог «недостаточная видимость» ---
SHARPNESS_MIN=60.0
BRIGHTNESS_MIN=50.0
LOW_VIS_MIN_SEC=2.0

# --- Фронтенд ---
NEXT_PUBLIC_USE_MOCKS=false
API_INTERNAL_URL=http://api:8000
# Host bindings only; keep the internal API rewrite above unchanged.
WEB_PORT=3004
API_PORT=8000
# Optional: choose one stable name per independent installation, or use --project-name.
# COMPOSE_PROJECT_NAME=my-linesight

# --- Отчёт ---
# Часовой пояс даты в PDF (в интерфейсе время показывается по часам браузера). По умолчанию UTC.
REPORT_TZ=UTC
